# ── Polymarket credentials ─────────────────────────────────────────────────
# Leave POLYMARKET_PRIVATE_KEY BLANK to stay in PAPER mode (no real money).
# Get the API creds from https://polymarket.com/profile → API Keys (or leave
# them blank and they'll be derived from the private key automatically).
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
# Your EVM wallet private key (Polygon). Setting this switches the agent LIVE.
POLYMARKET_PRIVATE_KEY=
# Live execution settings:
#   SIGNATURE_TYPE 2 = Polymarket proxy/email wallet (default for polymarket.com
#   accounts); 0 = a plain EOA you control. For type 1/2 you MUST set FUNDER to
#   your Polymarket deposit (proxy) address that holds the USDC.
POLYMARKET_SIGNATURE_TYPE=2
POLYMARKET_FUNDER=
AUTO_APPROVE_USDC=true
ENABLE_REDEEM=true
POLYGON_RPC=https://polygon-rpc.com

# ── Risk settings (override defaults) ─────────────────────────────────────
MAX_POSITION_SIZE_USD=5
MAX_CONCURRENT_POSITIONS=3
MIN_EDGE_THRESHOLD=0.04
MAX_DAILY_LOSS_USD=200
KELLY_FRACTION=0.25

# ── Paths ──────────────────────────────────────────────────────────────────
DB_PATH=data/trading.db
LOG_PATH=logs/agent.log
MODEL_PATH=data/model.pkl
